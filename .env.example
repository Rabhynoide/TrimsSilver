# Copy this file to .env and fill in real values. .env is gitignored.

# --- Ports (all configurable so this stack can run alongside others on a
# shared Docker host) ---
APP_PORT=3000
POSTGRES_PORT=5432

# --- Database ---
POSTGRES_USER=albion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=albion_market

# Host inside `docker compose` must be the *service name* (`db`), since the
# app and db containers talk to each other over the compose network, not
# via the host-mapped POSTGRES_PORT above. If you run the Next.js app
# outside Docker (e.g. `npm run dev` on your machine) against the
# dockerized Postgres, use `localhost:${POSTGRES_PORT}` instead.
DATABASE_URL=postgresql://albion:change-me@db:5432/albion_market

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL the app is reached at (used to build OAuth callback URLs).
BETTER_AUTH_URL=http://localhost:3000

# --- Discord OAuth (Developer Portal: https://discord.com/developers/applications) ---
# Callback URL to register there: ${BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
